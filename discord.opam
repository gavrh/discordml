maintainer: ["Gavin Holmes"]
authors: ["Gavin Holmes"]
license: "MIT"
tags: ["discord"]
homepage: "https://github.com/gavrh/discordml"
bug-reports: "https://github.com/gavrh/discordml/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.2"}
  "eio"
  "eio_main"
  "cohttp-eio"
  "http"
  "uri"
  "tls"
  "tls-eio"
  "ca-certs"
  "yojson"
  "ppx_deriving"
  "ppx_deriving_yojson"
  "dotenv"
  "domain-name"
  "digestif"
  "mirage-crypto-rng"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/gavrh/discordml.git"
x-maintenance-intent: ["(latest)"]
